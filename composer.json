{
  "name": "calien/secure-filemount",
  "description": "Login secured filemount for internal pages",
  "license": [
    "GPL-2.0-or-later"
  ],
  "keywords": [
    "TYPO3 CMS"
  ],
  "type": "typo3-cms-extension",
  "authors": [
    {
      "name": "Markus Hofmann",
      "role": "Developer",
      "email": "typo3@calien.de"
    }
  ],
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
    "typo3/cms-backend": "^13.4 || ^14.3",
    "typo3/cms-core": "^13.4 || ^14.3",
    "typo3/cms-filelist": "^13.4 || ^14.3",
    "typo3/cms-frontend": "^13.4 || ^14.3"
  },
  "require-dev": {
    "typo3/testing-framework": "^9.5",
    "saschaegerer/phpstan-typo3": "^2.1 || ^3.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "apache-solr-for-typo3/solr": "^13.0 || ^14.0@beta",
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "apache-solr-for-typo3/solr": "For indexing files with permission restrictions"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "secure_filemount",
      "version": "3.0.0",
      "Package": {
        "providesPackages": {}
      }
    },
    "branch-alias": {
      "dev-main": "3.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Calien\\SecureFilemount\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Calien\\SecureFilemount\\Tests\\": "Tests/"
    }
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
